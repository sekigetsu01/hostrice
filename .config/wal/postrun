#!/bin/bash
c=${XDG_CACHE_HOME:-$HOME/.cache}/wal
d=${XDG_CONFIG_HOME:-$HOME/.config}
mkdir -p "$d/btop/themes" "$d/yazi"
rm -f "$d/btop/themes/wallust.theme"  # (its name under wallust)
ln -sf "$c/btop.theme" "$d/btop/themes/pywal.theme"
ln -sf "$c/yazi-theme.toml" "$d/yazi/theme.toml"

# kitty: pywal's sequences only reach windows open right now; the shared kitty (and any with their own process)
# keeps the colours it started with for every new window unless it's told the new ones (--configured)
for sock in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/kitty-*; do
    [ -S "$sock" ] && timeout 3 /usr/bin/kitty @ --to "unix:$sock" set-colors --all --configured "$c/kitty-colors.conf" >/dev/null 2>&1 &
done

# open nvims recolour (WalReload in init.vim)
for sock in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/nvim.*.0; do
    [ -S "$sock" ] && timeout 3 nvim --server "$sock" --remote-expr 'execute("call WalReload()")' >/dev/null 2>&1 &
done

# open swayimgs reread the colours (on_signal USR1 in its init.lua)
pkill -USR1 -x swayimg 2>/dev/null

# open btops reread their config, and with it the theme
pkill -USR2 -x btop 2>/dev/null


# the browser
timeout 5 pywalfox update >/dev/null 2>&1 &
wait

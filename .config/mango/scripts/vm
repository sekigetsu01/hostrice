#!/bin/bash
# vm NAME: the VM's window (virt-manager); pressed again with it open, it powers the VM on too
c=qemu:///system
name=${1:?usage: vm NAME}

if mmsg get all-clients 2>/dev/null | python3 -I -c 'import json, sys
sys.exit(0 if any(c.get("appid") == "virt-manager" and c.get("title") == sys.argv[1] + " on QEMU/KVM"
                  for c in json.load(sys.stdin).get("clients", [])) else 1)' "$name"; then
    case $(virsh -c "$c" domstate "$name" 2>/dev/null) in
        "shut off" | crashed) out=$(virsh -c "$c" start "$name" 2>&1) ;;
        paused) out=$(virsh -c "$c" resume "$name" 2>&1) ;;
        *) true ;;
    esac || notify-send -a "Virtual machines" "Couldn't start $name" "$out"
fi
exec virt-manager --connect "$c" --show-domain-console "$name"

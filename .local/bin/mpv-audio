#!/bin/bash
# Playing audio (yazi's Enter, opening an audio file anywhere): what's in ~/Audiobooks plays in Books, anything else in
# a small mpv window. One file: the rest of its folder plays after it (not what's in folders inside it).
# shellcheck source-path=SCRIPTDIR source=../lib/common.sh
. "$HOME/.local/lib/common.sh" || exit 1
[ "$#" -gt 0 ] || { notify "mpv-audio" "Give it a file or a link to play"; echo "Usage: mpv-audio FILE|URL…" >&2; exit 1; }
f=$(readlink -f -- "$1")
case $f in "$(readlink -f "${BOOKS_DIR:-$HOME/Audiobooks}")"/*) exec "$HOME/.local/bin/books" "$f" ;; esac
if [ "$#" -eq 1 ] && [ ! -d "$1" ]; then set -- --autocreate-playlist=same --directory-mode=ignore -- "$@"; else set -- -- "$@"; fi
term_exec --app-id=mpv-audio --title=mpv -e mpv --no-video --term-osd-bar "$@"
